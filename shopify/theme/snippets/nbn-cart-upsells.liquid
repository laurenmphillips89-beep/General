{% comment %}
  Nourish by Nature: "Little ones also love" slider in the cart drawer.
  Suggestions change with what's in the cart. Products already in the cart are skipped.
  Rendered in snippets/cart-form.liquid, below the cart items.
{% endcomment %}

{%- liquid
  assign in_cart = '|'
  assign has_mat = false
  assign has_bath = false
  assign has_crayons = false
  for item in cart.items
    assign in_cart = in_cart | append: item.product.handle | append: '|'
    case item.product.type
      when 'Re-Usable Silicone Mats'
        assign has_mat = true
      when 'Bath Time Fun'
        assign has_bath = true
      when 'Crayons'
        assign has_crayons = true
    endcase
  endfor

  assign picks = ''
  if has_mat
    assign picks = picks | append: 'replacement-pens-for-silicone-colouring-mats,silicone-colouring-mat-seek-n-spot-dinosaur,silicone-colouring-mat-seek-n-spot-under-the-sea,silicone-colouring-mat-aussie-animals,'
  endif
  if has_bath
    assign picks = picks | append: 'bath-colour-rocks,beeswax-bath-crayons-kids,silicone-colouring-mat-seek-n-spot-under-the-sea,'
  endif
  if has_crayons
    assign picks = picks | append: 'silicone-colouring-mat-seek-n-spot-dinosaur,beeswax-bath-crayons-kids,bee-long-eco-friendly-beeswax-crayons,'
  endif
  assign picks = picks | append: 'kids-colourful-adventure-dinosaurs-and-trucks,bath-colour-rocks,bee-long-eco-friendly-beeswax-crayons,silicone-colouring-mat-seek-n-spot-under-the-sea,bath-artistry-kit'
  assign handles = picks | split: ',' | uniq
  assign shown = 0
-%}

<style>
  .nbn-upsells { margin: 22px 0 18px; }
  .nbn-upsells__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .nbn-upsells__title { font-weight: 700; }
  .nbn-upsells__nav { display: flex; gap: 6px; }
  .nbn-upsells__nav button { width: 30px; height: 30px; border-radius: 50%; border: 1px solid #E1E6D6; background: #fff; color: #2B4325; cursor: pointer; font-size: 16px; line-height: 1; }
  .nbn-upsells__track { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; }
  .nbn-upsells__track::-webkit-scrollbar { display: none; }
  .nbn-upsell { flex: 0 0 78%; scroll-snap-align: start; display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 12px; align-items: center; padding: 10px; border: 1px solid #E1E6D6; border-radius: 14px; background: #FFF9DA; }
  .nbn-upsell img { width: 64px; height: 64px; object-fit: cover; border-radius: 10px; background: #fff; }
  .nbn-upsell__name { display: block; font-weight: 700; font-size: 14px; line-height: 1.3; }
  .nbn-upsell__why { display: block; font-size: 12px; line-height: 1.35; opacity: .75; margin-top: 2px; }
  .nbn-upsell__row { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 6px; }
  .nbn-upsell__row strong { font-size: 14px; }
  .nbn-upsell__add { font: inherit; font-size: 13px; font-weight: 700; padding: 5px 14px; border-radius: 999px; border: 0; background: #2B4325; color: #FFF9DA; cursor: pointer; }
  .nbn-upsell__add[disabled] { opacity: .6; cursor: wait; }
  .nbn-upsells button:focus-visible { outline: 3px solid #9AD1D4; outline-offset: 2px; }
</style>

{%- capture cards -%}
    {%- for handle in handles -%}
      {%- liquid
        if shown >= 4
          break
        endif
        if handle == blank
          continue
        endif
        assign needle = '|' | append: handle | append: '|'
        if in_cart contains needle
          continue
        endif
        assign p = all_products[handle]
        if p == blank or p.available == false
          continue
        endif
        assign v = p.selected_or_first_available_variant
        assign shown = shown | plus: 1

        case handle
          when 'replacement-pens-for-silicone-colouring-mats'
            assign why = 'For the markers that vanish down the couch'
          when 'bath-colour-rocks'
            assign why = 'Colour the whole bath. Our best-seller!'
          when 'beeswax-bath-crayons-kids'
            assign why = 'Hand-poured in Sydney, mess-free in the tub'
          when 'bee-long-eco-friendly-beeswax-crayons'
            assign why = 'Award runner-up. Longer crayons, more colouring'
          when 'kids-colourful-adventure-dinosaurs-and-trucks'
            assign why = 'Crayons, mat + colouring book. Gift sorted'
          when 'bath-artistry-kit'
            assign why = 'Crayons + colour rocks in a gift box'
          else
            assign why = 'Mess-free creative play, anywhere'
        endcase
      -%}
      <div class="nbn-upsell">
        <a href="{{ p.url }}" tabindex="-1">
          <img src="{{ p.featured_image | image_url: width: 160 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" width="64" height="64" loading="lazy">
        </a>
        <div>
          <a href="{{ p.url }}" class="nbn-upsell__name">{{ p.title | escape }}</a>
          <span class="nbn-upsell__why">{{ why }}</span>
          <div class="nbn-upsell__row">
            <strong>{{ v.price | money }}</strong>
            <button type="button" class="nbn-upsell__add" data-nbn-add="{{ v.id }}">+ Add</button>
          </div>
        </div>
      </div>
    {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
<div class="nbn-upsells" data-nbn-upsells>
  <div class="nbn-upsells__head">
    <span class="nbn-upsells__title">Little ones also love</span>
    <div class="nbn-upsells__nav">
      <button type="button" data-nbn-scroll="-1" aria-label="Previous suggestions">‹</button>
      <button type="button" data-nbn-scroll="1" aria-label="More suggestions">›</button>
    </div>
  </div>
  <div class="nbn-upsells__track">
    {{ cards }}
  </div>
</div>
{%- endif -%}
